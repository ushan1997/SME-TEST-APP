# --- Django security ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret-key
DJANGO_CORS_ALLOW_ALL=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_LOG_LEVEL=WARNING
LOGIN_LOCKOUT_MAX_FAILURES=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# --- Database ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sme_scoring
DB_USER=prod_db_manager
DB_PASSWORD=ima@2002
DB_HOST=db
DB_PORT=5432

# --- Docker Postgres initialization ---
POSTGRES_DB=sme_scoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ima@2002

DB_HOST=db