# ==========================================
# SME-TEST-APP Master Gitignore
# ==========================================

# --- Environment & Secrets (CRITICAL) ---
.env
.env.*
!.env.example
*.local
secrets.json

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
.python-version
venv/
.venv/
env/
ENV/
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
*.log

# --- Node & Frontend ---
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Editors & IDEs ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS Specific ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# --- Other Junk ---
.cache/
tmp/